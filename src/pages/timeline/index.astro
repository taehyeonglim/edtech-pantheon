---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CitationList from '../../components/CitationList.astro';
import { pioneers } from '../../data/pioneers';
import { portraitById } from '../../data/portraits';
import { nationalityById } from '../../data/nationalities';
import { getFlagIcons } from '../../data/flag-icons';
import {
  getTimelineTrackId,
  pioneerTimelineTrack,
  timelineTracks
} from '../../data/timeline-tracks';

const base = `${import.meta.env.BASE_URL}/`;
const events = pioneers
  .flatMap((pioneer) => pioneer.timeline.map((event) => {
    const trackId = getTimelineTrackId(pioneer.id, event.year);
    return {
      ...event,
      pioneer,
      trackId,
      isCrossover: trackId !== pioneerTimelineTrack[pioneer.id]
    };
  }))
  .sort((a, b) => a.year - b.year);
const timelineStart = events[0]?.year ?? 1898;
const timelineEnd = events[events.length - 1]?.year ?? new Date().getFullYear();
const timelineSpan = Math.max(1, timelineEnd - timelineStart);
const makeYearTicks = (start: number, end: number) => {
  const ticks = new Set([start, end]);
  for (let year = Math.ceil(start / 5) * 5; year <= end; year += 5) ticks.add(year);
  return [...ticks].sort((a, b) => a - b);
};
const ticks = makeYearTicks(timelineStart, timelineEnd);
const domains = [...new Set(pioneers.flatMap((pioneer) => pioneer.domains))].sort((a, b) => a.localeCompare(b, 'ko'));
const eras = [
  {
    id: 'foundations', start: timelineStart, end: 1939, label: 'FOUNDATIONS',
    title: '실험·경험·발달의 기초',
    description: '측정, 경험, 발달, 문화와 자동화된 학습을 둘러싼 기초 언어가 등장한 구간.'
  },
  {
    id: 'formation', start: 1940, end: 1969, label: 'FORMATION',
    title: '목표·행동·인지의 형성',
    description: '교육목표, 프로그램 학습, 학습 조건과 인지적 표상이 설계 언어로 조직된 구간.'
  },
  {
    id: 'systems', start: 1970, end: 1994, label: 'SYSTEMS & CONTEXT',
    title: '체제·맥락·구성의 확장',
    description: '체제적 교수설계, 상황학습, 인지부하와 구성주의 학습환경이 서로 다른 축으로 확장된 구간.'
  },
  {
    id: 'integration', start: 1995, end: timelineEnd, label: 'INTEGRATION',
    title: '디지털·문제·통합의 시대',
    description: '멀티미디어, 문제 중심 설계와 설계·개발 연구가 디지털 학습 환경에서 통합된 구간.'
  }
];
const eraBands = eras.map((era, index) => {
  const bandEnd = index < eras.length - 1 ? eras[index + 1].start : timelineEnd;
  const startPosition = ((era.start - timelineStart) / timelineSpan) * 100;
  const endPosition = ((bandEnd - timelineStart) / timelineSpan) * 100;
  return {
    ...era,
    startPosition,
    heightPosition: Math.max(0, endPosition - startPosition),
    eventCount: events.filter((event) => event.year >= era.start && event.year <= era.end).length
  };
});
const tracks = timelineTracks.map((track, index) => ({
  ...track,
  index,
  events: events.filter((event) => event.trackId === track.id),
  pioneerCount: new Set(events.filter((event) => event.trackId === track.id).map((event) => event.pioneer.id)).size
}));
const getEraId = (year: number) => eras.find((era) => year >= era.start && year <= era.end)?.id ?? eras[eras.length - 1].id;
---
<BaseLayout title="통합 연표">
  <section class="page-hero">
    <div class="shell">
      <div class="eyebrow">THE TIMELINE / {timelineStart}—{timelineEnd}</div>
      <h1>한 세기의<br /><em style="color:var(--gold-light);font-style:normal">학습 실험</em></h1>
      <p>인물의 생애만 나열하지 않고, 주요 저작과 개념이 교육공학의 언어를 어떻게 바꾸었는지 시간의 흐름으로 읽습니다.</p>
      <div class="hero-meta">
        <span><b>{events.length}</b> DOCUMENTED EVENTS</span>
        <span><b>{eras.length}</b> EDITORIAL ERAS</span>
        <span><b>{tracks.length}</b> RESEARCH TRACKS</span>
      </div>
    </div>
  </section>
  <section class="section timeline-page">
    <div class="shell">
      <div class="timeline-intro">
        <p>연표는 “누가 먼저였는가”를 가리는 순위표가 아닙니다. 같은 시대에 서로 다른 질문이 어떻게 등장했고, 후대의 연구자가 어떤 언어를 이어받았는지 보기 위한 탐색 장치입니다.</p>
        <div class="method-note"><strong>다섯 연구 계보는 모두 {timelineStart}—{timelineEnd}의 동일한 연도축을 공유합니다.</strong> 열은 배치용 번호가 아니라 학습·평가·설계·매체·사회학습의 지적 흐름을 뜻합니다. 같은 연도의 기준점은 모든 트랙에서 같은 높이를 유지하고, 분야를 건너간 사건은 CROSSOVER로 표시합니다.</div>
      </div>

      <div class="timeline-era-legend" aria-label="연표 시대 구분">
        {eraBands.map((era, eraIndex) => (
          <article>
            <div class="timeline-era-legend-top">
              <span>PERIOD {String(eraIndex + 1).padStart(2, '0')} / {era.label}</span>
              <b>{era.eventCount} EVENTS</b>
            </div>
            <div class="timeline-era-legend-range">{era.start}<i aria-hidden="true">→</i>{era.end}</div>
            <h2>{era.title}</h2>
            <p>{era.description}</p>
          </article>
        ))}
      </div>

      <div class="timeline-track-legend" aria-label="연표 연구 계보 구분">
        {tracks.map((track) => (
          <article style={`--track-accent:${track.accent}`}>
            <div>
              <span>TRACK {String(track.index + 1).padStart(2, '0')}</span>
              <b>{track.events.length} EVENTS · {track.pioneerCount} PIONEERS</b>
            </div>
            <h2>{track.title}</h2>
            <p>{track.description}</p>
          </article>
        ))}
      </div>

      <div class="timeline-filter-bar" data-timeline-filter>
        <div class="timeline-filter-heading">
          <span>FOCUS THE ARCHIVE</span>
          <strong>{events.length}개 기록에서 필요한 흐름만 남기기</strong>
        </div>
        <label>
          <span>인물</span>
          <select data-timeline-person>
            <option value="all">전체 {pioneers.length}명</option>
            {[...pioneers]
              .sort((a, b) => (a.birthYear ?? 9999) - (b.birthYear ?? 9999) || a.nameKo.localeCompare(b.nameKo, 'ko'))
              .map((pioneer) => <option value={pioneer.id}>{pioneer.nameKo} · {pioneer.life}</option>)}
          </select>
        </label>
        <label>
          <span>연구 계보</span>
          <select data-timeline-track>
            <option value="all">전체 5개 계보</option>
            {tracks.map((track) => <option value={track.id}>{track.shortTitle}</option>)}
          </select>
        </label>
        <label>
          <span>연구 분야</span>
          <select data-timeline-domain>
            <option value="all">전체 분야</option>
            {domains.map((domain) => <option value={domain}>{domain}</option>)}
          </select>
        </label>
        <label>
          <span>시대</span>
          <select data-timeline-era>
            <option value="all">전체 시대</option>
            {eras.map((era) => <option value={era.id}>{era.start}—{era.end} · {era.title}</option>)}
          </select>
        </label>
        <button type="button" data-timeline-reset disabled>필터 초기화</button>
        <p data-timeline-result aria-live="polite">{events.length} / {events.length} EVENTS</p>
      </div>

      <p class="timeline-scroll-hint">큰 화면에서는 다섯 계보를 같은 연도축에서 비교하고, 좁은 화면에서는 계보별 시간순 목록으로 이어 읽습니다.</p>
      <div class="timeline-shared-scroll" tabindex="0" aria-label="다섯 연구 계보 트랙으로 구성된 통합 연표">
        <div class="timeline-shared-frame" data-timeline-frame style={`--visible-track-count:${tracks.length}`}>
          <header class="timeline-lane-head">
            <div class="timeline-axis-heading"><span>YEAR</span><b>{timelineStart}—{timelineEnd}</b></div>
            {tracks.map((track) => (
              <div class="timeline-lane-heading" data-timeline-track-heading data-track-id={track.id} style={`--track-accent:${track.accent}`}>
                <span>{track.label}</span>
                <strong>{track.shortTitle}</strong>
                <b><i data-track-visible-count>{track.events.length}</i> EVENTS</b>
              </div>
            ))}
          </header>

          <div
            class="timeline-shared-canvas"
            data-shared-timeline
            data-timeline-start={timelineStart}
            data-timeline-end={timelineEnd}
          >
            <div class="timeline-era-bands" aria-hidden="true">
              {eraBands.map((era, eraIndex) => (
                <section
                  class:list={["timeline-era-band", { alternate: eraIndex % 2 === 1 }]}
                  style={`--band-start:${era.startPosition}%;--band-height:${era.heightPosition}%`}
                >
                  <span>{era.start} / {era.label}</span>
                  <b>{era.title}</b>
                </section>
              ))}
            </div>

            <div class="timeline-shared-axis" aria-hidden="true">
              {ticks.map((year) => {
                const tickPosition = ((year - timelineStart) / timelineSpan) * 100;
                return (
                  <span
                    class:list={["timeline-axis-tick", { edge: year === timelineStart || year === timelineEnd }]}
                    style={`--tick-position:${tickPosition}%`}
                  >
                    <b>{year}</b><i></i>
                  </span>
                );
              })}
            </div>

            <div class="timeline-lanes" data-timeline-lanes>
              {tracks.map((track) => (
                <ol class="timeline-lane" data-timeline-lane data-track-id={track.id} data-track-label={`${track.label} / ${track.title}`} style={`--track-accent:${track.accent}`} aria-label={track.title}>
                  {track.events.map((event) => {
                    const portrait = portraitById[event.pioneer.id];
                    const nationality = nationalityById[event.pioneer.id];
                    const flagIcons = getFlagIcons(nationality.flag);
                    const portraitStyle = portrait ? [
                      portrait.objectPosition && `object-position:${portrait.objectPosition}`,
                      portrait.objectScale && `transform:scale(${portrait.objectScale})`,
                      portrait.transformOrigin && `transform-origin:${portrait.transformOrigin}`
                    ].filter(Boolean).join(';') : undefined;
                    const yearPosition = ((event.year - timelineStart) / timelineSpan) * 100;

                    return (
                      <li
                        class="timeline-lane-event"
                        data-timeline-event
                        data-event-year={event.year}
                        data-pioneer-id={event.pioneer.id}
                        data-event-domains={event.pioneer.domains.join('|')}
                        data-era-id={getEraId(event.year)}
                        data-track-id={event.trackId}
                        style={`--year-position:${yearPosition}%;--anchor-offset:0px;--connector-height:0px`}
                      >
                        <article class="global-event" style={`--event-accent:${event.pioneer.accent}`}>
                          <div class="global-event-top">
                            <time class="global-event-year" datetime={String(event.year)}>{event.year}</time>
                            <span>{event.isCrossover && <b class="event-crossover">↗ CROSSOVER</b>}{event.pioneer.school}</span>
                          </div>
                          <h3>{event.label}</h3>
                          <p>{event.description}</p>
                          <div class="event-person">
                            <span class="event-person-portrait-wrap">
                              <a
                                class:list={["event-person-portrait", { 'has-photo': portrait }]}
                                href={`${base}pioneers/${event.pioneer.slug}/`}
                                aria-label={`${event.pioneer.nameKo} 상세 기록`}
                                title={event.pioneer.nameKo}
                              >
                                {portrait
                                  ? <img src={`${base}${portrait.src}`} alt="" loading="lazy" style={portraitStyle} />
                                  : <span aria-hidden="true">{event.pioneer.initials}</span>}
                              </a>
                              <span class="nationality-badge is-compact event-person-nationality" title={nationality.note} aria-label={`국적: ${nationality.label}`}>
                                {flagIcons.map((flag) => (
                                  <span class="country-flag">
                                    <small>{flag.code}</small>
                                    <img src={`${base}flags/${flag.file}`} alt={flag.alt} width="20" height="14" loading="lazy" />
                                  </span>
                                ))}
                              </span>
                            </span>
                            <div class="event-person-name">
                              <a href={`${base}pioneers/${event.pioneer.slug}/`}>{event.pioneer.nameKo}</a>
                              <small>{event.pioneer.nameEn}</small>
                            </div>
                          </div>
                          <CitationList ids={event.sourceIds} compact />
                        </article>
                      </li>
                    );
                  })}
                </ol>
              ))}
            </div>
            <div class="timeline-empty-state" data-timeline-empty hidden>
              <span>NO EVENTS IN THIS VIEW</span>
              <p>조건을 넓히거나 필터를 초기화해 다른 연구 흐름을 확인하세요.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script>
    const layoutSharedTimeline = () => {
      document.querySelectorAll<HTMLElement>('[data-shared-timeline]').forEach((canvas) => {
        const start = Number(canvas.dataset.timelineStart);
        const end = Number(canvas.dataset.timelineEnd);
        const axisHeight = Number.parseFloat(getComputedStyle(canvas).getPropertyValue('--timeline-axis-height')) || 8200;
        const laneLayer = canvas.querySelector<HTMLElement>('[data-timeline-lanes]');
        let maximumBottom = axisHeight;

        if (window.matchMedia('(max-width: 980px)').matches) {
          canvas.querySelectorAll<HTMLElement>('[data-timeline-event]').forEach((event) => {
            event.style.removeProperty('top');
            event.style.setProperty('--anchor-offset', '0px');
            event.style.setProperty('--connector-height', '0px');
            event.classList.remove('is-displaced');
          });
          canvas.querySelectorAll<HTMLElement>('[data-timeline-lane]').forEach((lane) => lane.style.removeProperty('height'));
          canvas.style.removeProperty('height');
          laneLayer?.style.removeProperty('height');
          return;
        }

        canvas.querySelectorAll<HTMLElement>('[data-timeline-lane]').forEach((lane) => {
          const allLaneEvents = Array.from(lane.querySelectorAll<HTMLElement>('[data-timeline-event]'));
          allLaneEvents.forEach((event) => {
            if (!event.hidden) return;
            event.style.removeProperty('top');
            event.style.setProperty('--anchor-offset', '0px');
            event.style.setProperty('--connector-height', '0px');
          });
          const laneEvents = allLaneEvents.filter((event) => !event.hidden);
          let occupiedUntil = 0;

          laneEvents.forEach((event) => {
            const year = Number(event.dataset.eventYear);
            const desiredTop = ((year - start) / Math.max(1, end - start)) * axisHeight;
            const actualTop = Math.max(desiredTop, occupiedUntil);
            const displacement = Math.max(0, actualTop - desiredTop);
            event.style.top = `${actualTop}px`;
            event.style.setProperty('--anchor-offset', `${-displacement}px`);
            event.style.setProperty('--connector-height', `${displacement}px`);
            event.classList.toggle('is-displaced', displacement > 2);
            occupiedUntil = actualTop + event.offsetHeight + 22;
          });

          const laneHeight = Math.max(axisHeight, occupiedUntil + 28);
          lane.style.height = `${laneHeight}px`;
          maximumBottom = Math.max(maximumBottom, laneHeight);
        });

        canvas.style.height = `${maximumBottom}px`;
        if (laneLayer) laneLayer.style.height = `${maximumBottom}px`;
      });
    };

    let timelineLayoutFrame = 0;
    const scheduleTimelineLayout = () => {
      cancelAnimationFrame(timelineLayoutFrame);
      timelineLayoutFrame = requestAnimationFrame(layoutSharedTimeline);
    };

    scheduleTimelineLayout();
    window.addEventListener('load', scheduleTimelineLayout, { once: true });
    window.addEventListener('resize', scheduleTimelineLayout, { passive: true });
    document.fonts?.ready.then(scheduleTimelineLayout);

    const timelineFilter = document.querySelector<HTMLElement>('[data-timeline-filter]');
    const personFilter = timelineFilter?.querySelector<HTMLSelectElement>('[data-timeline-person]');
    const trackFilter = timelineFilter?.querySelector<HTMLSelectElement>('[data-timeline-track]');
    const domainFilter = timelineFilter?.querySelector<HTMLSelectElement>('[data-timeline-domain]');
    const eraFilter = timelineFilter?.querySelector<HTMLSelectElement>('[data-timeline-era]');
    const resetFilter = timelineFilter?.querySelector<HTMLButtonElement>('[data-timeline-reset]');
    const filterResult = timelineFilter?.querySelector<HTMLElement>('[data-timeline-result]');
    const timelineEvents = Array.from(document.querySelectorAll<HTMLElement>('[data-timeline-event]'));
    const timelineFrame = document.querySelector<HTMLElement>('[data-timeline-frame]');
    const timelineEmpty = document.querySelector<HTMLElement>('[data-timeline-empty]');
    const trackLanes = Array.from(document.querySelectorAll<HTMLOListElement>('[data-timeline-lane]'));

    const applyTimelineFilters = () => {
      const person = personFilter?.value ?? 'all';
      const track = trackFilter?.value ?? 'all';
      const domain = domainFilter?.value ?? 'all';
      const era = eraFilter?.value ?? 'all';
      let visibleCount = 0;

      timelineEvents.forEach((event) => {
        const domains = event.dataset.eventDomains?.split('|') ?? [];
        const matches =
          (person === 'all' || event.dataset.pioneerId === person) &&
          (track === 'all' || event.dataset.trackId === track) &&
          (domain === 'all' || domains.includes(domain)) &&
          (era === 'all' || event.dataset.eraId === era);
        event.hidden = !matches;
        if (matches) visibleCount += 1;
      });

      let visibleTrackCount = 0;
      trackLanes.forEach((lane) => {
        const visibleEvents = Array.from(lane.querySelectorAll<HTMLElement>('[data-timeline-event]')).filter((event) => !event.hidden);
        const trackId = lane.dataset.trackId;
        const heading = document.querySelector<HTMLElement>(`[data-timeline-track-heading][data-track-id="${trackId}"]`);
        const hasEvents = visibleEvents.length > 0;
        lane.hidden = !hasEvents;
        if (heading) {
          heading.hidden = !hasEvents;
          const count = heading.querySelector<HTMLElement>('[data-track-visible-count]');
          if (count) count.textContent = String(visibleEvents.length);
        }
        if (hasEvents) visibleTrackCount += 1;
      });

      timelineFrame?.style.setProperty('--visible-track-count', String(Math.max(1, visibleTrackCount)));
      if (timelineEmpty) timelineEmpty.hidden = visibleCount > 0;

      const isFiltered = person !== 'all' || track !== 'all' || domain !== 'all' || era !== 'all';
      if (resetFilter) resetFilter.disabled = !isFiltered;
      if (filterResult) filterResult.textContent = `${visibleCount} / ${timelineEvents.length} EVENTS`;
      scheduleTimelineLayout();
    };

    [personFilter, trackFilter, domainFilter, eraFilter].forEach((control) =>
      control?.addEventListener('change', applyTimelineFilters),
    );
    resetFilter?.addEventListener('click', () => {
      if (personFilter) personFilter.value = 'all';
      if (trackFilter) trackFilter.value = 'all';
      if (domainFilter) domainFilter.value = 'all';
      if (eraFilter) eraFilter.value = 'all';
      applyTimelineFilters();
    });
    applyTimelineFilters();
  </script>
</BaseLayout>
