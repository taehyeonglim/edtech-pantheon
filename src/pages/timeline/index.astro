---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CitationList from '../../components/CitationList.astro';
import { pioneers } from '../../data/pioneers';
const base = `${import.meta.env.BASE_URL}/`;
const events = pioneers.flatMap((pioneer) => pioneer.timeline.map((event) => ({ ...event, pioneer }))).sort((a, b) => a.year - b.year);
const timelineStart = events[0]?.year;
const timelineEnd = events[events.length - 1]?.year;
const eras = [
  {
    id: 'foundations', start: 1898, end: 1939, label: 'FOUNDATIONS',
    title: '관찰·측정과 경험',
    description: '실험심리학, 경험 중심 교육, 문화역사적 접근이 각자의 기초 언어를 세운 시기.'
  },
  {
    id: 'formation', start: 1940, end: 1969, label: 'FORMATION',
    title: '수업 이론의 체계화',
    description: '행동, 목표, 학습 조건, 인지 구조가 수업 설계를 위한 모형으로 조직된 시기.'
  },
  {
    id: 'expansion', start: 1970, end: 1989, label: 'EXPANSION',
    title: '인지·사회·설계의 확장',
    description: '사회적 학습, 구성, 동기, 교수설계가 서로 다른 설계 언어로 확장된 시기.'
  },
  {
    id: 'integration', start: 1990, end: 2013, label: 'INTEGRATION',
    title: '디지털 학습과 통합',
    description: '멀티미디어, 문제 중심 설계, 개정 모형이 디지털 학습 환경과 만난 시기.'
  }
].map((era) => ({ ...era, events: events.filter((event) => event.year >= era.start && event.year <= era.end) }));
---
<BaseLayout title="통합 연표">
  <section class="page-hero"><div class="shell"><div class="eyebrow">THE TIMELINE / {timelineStart}—{timelineEnd}</div><h1>한 세기의<br /><em style="color:var(--gold-light);font-style:normal">학습 실험</em></h1><p>인물의 생애만 나열하지 않고, 주요 저작과 개념이 교육공학의 언어를 어떻게 바꾸었는지 시간의 흐름으로 읽습니다.</p><div class="hero-meta"><span><b>{events.length}</b> DOCUMENTED EVENTS</span><span><b>{eras.length}</b> EDITORIAL ERAS</span><span><b>3</b> COLUMN VIEW</span></div></div></section>
  <section class="section timeline-page">
    <div class="shell">
      <div class="timeline-intro">
        <p>연표는 “누가 먼저였는가”를 가리는 순위표가 아닙니다. 같은 시대에 서로 다른 질문이 어떻게 등장했고, 후대의 연구자가 어떤 언어를 이어받았는지 보기 위한 탐색 장치입니다.</p>
        <div class="method-note">연도는 저작의 초판·발표 연도를 우선합니다. 아래 네 구간은 공식 시대 구분이 아니라 동시대 사건을 함께 읽기 위한 편집적 묶음이며, 각 이벤트의 근거는 연결된 출처에서 확인할 수 있습니다.</div>
      </div>
      <div class="timeline-eras">
        {eras.map((era, eraIndex) => (
          <section class="timeline-era" aria-labelledby={`era-${era.id}`}>
            <header class="timeline-era-header">
              <div class="timeline-era-number">{String(eraIndex + 1).padStart(2, '0')}</div>
              <div>
                <div class="timeline-era-kicker">{era.label} · {era.start}—{era.end}</div>
                <h2 id={`era-${era.id}`}>{era.title}</h2>
              </div>
              <p>{era.description}</p>
              <span class="timeline-era-count">{era.events.length} EVENTS</span>
            </header>
            <div class="timeline-event-grid">
              {era.events.map((event) => (
                <article class="global-event" style={`--event-accent:${event.pioneer.accent}`}>
                  <div class="global-event-top">
                    <time class="global-event-year" datetime={String(event.year)}>{event.year}</time>
                    <span>{event.pioneer.school}</span>
                  </div>
                  <h3>{event.label}</h3>
                  <p>{event.description}</p>
                  <div class="event-person"><span aria-hidden="true"></span><a href={`${base}pioneers/${event.pioneer.slug}/`}>{event.pioneer.nameKo}</a><small>{event.pioneer.nameEn}</small></div>
                  <CitationList ids={event.sourceIds} compact />
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
