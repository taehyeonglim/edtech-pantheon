---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { affiliations, institutionById, institutions } from '../../data/affiliations';
import { pioneers } from '../../data/pioneers';
import { portraitById } from '../../data/portraits';
import { sources } from '../../data/sources';
import { countryFlagByName } from '../../data/flag-icons';
import 'leaflet/dist/leaflet.css';

const base = `${import.meta.env.BASE_URL}/`;
const sourceById = Object.fromEntries(sources.map((source) => [source.id, source]));
const byName = [...pioneers].sort((a, b) => a.nameKo.localeCompare(b.nameKo, 'ko'));
const mappedInstitutions = institutions.filter((institution) => affiliations.some((affiliation) => affiliation.institutionId === institution.id));
const institutionMarkers = mappedInstitutions.map((institution) => {
  const records = affiliations.filter((affiliation) => affiliation.institutionId === institution.id);
  return { institution, records };
});
const atlasMapData = institutionMarkers.map(({ institution, records }) => ({
  ...institution,
  recordCount: records.length,
}));
const mappedAffiliations = affiliations;
---
<BaseLayout title="지식의 좌표" description="교육공학 사상가들의 대표 교수·연구 활동 거점을 세계지도에서 읽습니다.">
  <section class="page-hero atlas-hero"><div class="shell"><div class="eyebrow">THE ATLAS / INSTITUTIONAL GEOGRAPHY</div><h1>지식은<br />어디에 <em>머물렀나.</em></h1><p>이 지도는 출생지나 학위 취득지가 아니라, 현재 아카이브가 확인한 대표 교수·연구 활동 거점을 보여줍니다. 하나의 핀은 한 대학 또는 연구기관이며, 모든 경력의 완전한 목록은 아닙니다.</p><div class="hero-meta"><span><b>{pioneers.length}</b> SCHOLARS</span><span><b>{mappedInstitutions.length}</b> INSTITUTIONS</span><span><b>{mappedAffiliations.length}</b> VERIFIED ACTIVITY RECORDS</span></div></div></section>
  <section class="section atlas-page">
    <div class="shell atlas-layout">
      <div class="atlas-controls">
        <label for="atlas-pioneer"><span>FOLLOW A SCHOLAR</span><strong>학자 활동 거점</strong></label>
        <select id="atlas-pioneer" data-atlas-pioneer>
          <option value="">전체 학자 · 기관 분포</option>
          {byName.map((pioneer) => <option value={pioneer.id}>{pioneer.nameKo} · {pioneer.nameEn}</option>)}
        </select>
        <div class="atlas-kind-filter" role="group" aria-label="기관 유형 필터">
          <button type="button" class="is-active" data-atlas-kind="all">전체</button>
          <button type="button" data-atlas-kind="university">대학</button>
          <button type="button" data-atlas-kind="research">연구기관</button>
          <button type="button" data-atlas-kind="professional">전문 활동</button>
        </div>
      </div>
      <div class="atlas-map-wrap">
        <div class="atlas-map" data-atlas-map data-points={JSON.stringify(atlasMapData)} role="region" aria-label="교육공학 사상가들의 대표 교수 및 연구 활동 기관 실제 지도"></div>
        <p class="atlas-map-note"><span>MAP KEY</span> 지도 위에서 마우스 휠로 확대·축소할 수 있습니다. 대학·연구기관은 검증한 캠퍼스 또는 건물 좌표에 표시하며, 전문 활동 두 곳만 공개 주소가 없어 도시 중심 좌표를 사용합니다.</p>
      </div>
      <aside class="atlas-detail" data-atlas-detail>
        <span>SELECT A POINT</span>
        <h2>세계의 활동 거점</h2>
        <p>지도 위의 원 또는 학자 선택 메뉴를 사용하세요. 선택하면 해당 기관과 연결된 활동 기록을 확인할 수 있습니다.</p>
      </aside>
      {institutionMarkers.map(({ institution, records }) => (
        <template data-atlas-detail-template={institution.id}>
          <div class="atlas-detail-card">
            {institution.imageUrl ? (
              <a class:list={['atlas-institution-visual', { 'is-emblem': institution.imageKind === 'emblem' }]} href={institution.imageSourceUrl} target="_blank" rel="noreferrer" aria-label={`${institution.nameKo} 이미지 출처`}>
                <img src={institution.imageUrl} alt={`${institution.nameKo} ${institution.imageKind === 'emblem' ? '엠블럼' : '캠퍼스'}`} loading="lazy" />
              </a>
            ) : <div class="atlas-institution-monogram" aria-hidden="true">{institution.nameEn.split(' ').map((word) => word[0]).join('').slice(0, 3)}</div>}
            <span>INSTITUTION SELECTED</span>
            <h2>{institution.nameKo}</h2>
            <p>{institution.nameEn}<br />{institution.city} · {institution.country} · {records.length}개 대표 활동 기록</p>
            <div class="atlas-detail-links">
              {institution.websiteUrl && <a href={institution.websiteUrl} target="_blank" rel="noreferrer">공식 홈페이지 ↗</a>}
              <a href={institution.coordinateSourceUrl} target="_blank" rel="noreferrer">좌표 근거 · OpenStreetMap ↗</a>
              {institution.imageSourceUrl && <a href={institution.imageSourceUrl} target="_blank" rel="noreferrer">이미지 근거 · {institution.imageLicense} ↗</a>}
            </div>
          </div>
        </template>
      ))}
    </div>
    <div class="shell atlas-records" data-atlas-records>
      <header><span>VERIFIED ACTIVITY RECORDS</span><strong data-atlas-count>{mappedAffiliations.length} RECORDS</strong></header>
      <div class="atlas-record-grid">
        {mappedAffiliations.map((affiliation) => {
          const pioneer = pioneers.find((item) => item.id === affiliation.pioneerId)!;
          const institution = institutionById[affiliation.institutionId];
          const portrait = portraitById[pioneer.id];
          const source = sourceById[affiliation.sourceIds[0]];
          const countryFlag = countryFlagByName[institution.country];
          return <article class="atlas-record" data-atlas-record data-pioneer={pioneer.id} data-institution={institution.id} data-kind={institution.kind}>
            <div class="atlas-record-person">
              {portrait && <span class="atlas-record-portrait"><img src={`${base}${portrait.src}`} alt="" loading="lazy" style={[portrait.objectPosition && `object-position:${portrait.objectPosition}`, portrait.objectScale && `transform:scale(${portrait.objectScale})`, portrait.transformOrigin && `transform-origin:${portrait.transformOrigin}`].filter(Boolean).join(';')} /></span>}
              <div><h3>{pioneer.nameKo}</h3><span>{pioneer.nameEn}</span></div>
            </div>
            <p class="atlas-record-role">{affiliation.role}</p>
            <p class="atlas-record-place">{institution.nameKo} <span>{institution.city} · {countryFlag && <span class="atlas-country-flag"><small>{countryFlag.code}</small><img src={`${base}flags/${countryFlag.file}`} alt={countryFlag.alt} width="20" height="14" loading="lazy" /></span>} {institution.country}</span></p>
            <p class="atlas-record-period">{affiliation.startYear ? `${affiliation.startYear}—${affiliation.endYear ?? '현재'}` : '기간 공개 전거 미확인'}</p>
            <div class="atlas-record-links">
              {source && <a href={source.url} target="_blank" rel="noreferrer">활동 근거 · {source.publisher ?? source.authors} ↗</a>}
              <a href={institution.coordinateSourceUrl} target="_blank" rel="noreferrer">좌표 ↗</a>
            </div>
          </article>;
        })}
      </div>
      <p class="atlas-empty" data-atlas-empty hidden>선택한 조건에 맞는 대표 활동 기록이 없습니다.</p>
    </div>
  </section>
  <script>
    import L from 'leaflet';

    type AtlasPoint = {
      id: string;
      nameKo: string;
      nameEn: string;
      city: string;
      country: string;
      latitude: number;
      longitude: number;
      kind: 'university' | 'research' | 'professional';
      coordinatePrecision: 'building' | 'campus' | 'city';
      recordCount: number;
    };

    const select = document.querySelector('[data-atlas-pioneer]') as HTMLSelectElement | null;
    const records = [...document.querySelectorAll('[data-atlas-record]')] as HTMLElement[];
    const kindButtons = [...document.querySelectorAll('[data-atlas-kind]')] as HTMLButtonElement[];
    const detail = document.querySelector('[data-atlas-detail]') as HTMLElement | null;
    const count = document.querySelector('[data-atlas-count]') as HTMLElement | null;
    const empty = document.querySelector('[data-atlas-empty]') as HTMLElement | null;
    const mapElement = document.querySelector('[data-atlas-map]') as HTMLElement | null;
    const points = JSON.parse(mapElement?.dataset.points || '[]') as AtlasPoint[];
    const defaultDetailNodes = detail ? [...detail.childNodes].map((node) => node.cloneNode(true)) : [];
    let kind = 'all';
    let institution = '';
    let visibleInstitutionIds = new Set(points.map((point) => point.id));

    const map = mapElement ? L.map(mapElement, {
      center: [28, 5],
      zoom: 2,
      minZoom: 2,
      maxZoom: 18,
      scrollWheelZoom: true,
      worldCopyJump: true,
      zoomControl: true,
    }) : null;

    if (map) {
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>',
      }).addTo(map);
    }

    const markerEntries = points.map((point) => {
      const precisionLabel = point.coordinatePrecision === 'city' ? '도시 중심' : point.coordinatePrecision === 'building' ? '건물' : '캠퍼스';
      const marker = L.marker([point.latitude, point.longitude], {
        icon: L.divIcon({
          className: 'atlas-leaflet-marker',
          html: `<span class="atlas-marker-pin"><b>${point.recordCount}</b></span>`,
          iconSize: [36, 36],
          iconAnchor: [18, 18],
        }),
        keyboard: true,
        title: `${point.nameKo} · ${point.city} · ${precisionLabel} 좌표`,
        alt: `${point.nameKo}, ${point.city}, ${point.recordCount}개 대표 활동 기록`,
      });
      marker.bindTooltip(`<strong>${point.nameKo}</strong><span>${point.city} · ${point.recordCount} RECORDS</span>`, { direction: 'top', offset: [0, -15] });
      marker.on('click', () => {
        if (visibleInstitutionIds.has(point.id)) selectInstitution(point.id);
      });
      marker.addTo(map!);
      return { point, marker };
    });

    const fitMapTo = (ids: Set<string>, maximumZoom = 3) => {
      if (!map) return;
      const coordinates = markerEntries
        .filter(({ point }) => ids.has(point.id))
        .map(({ point }) => [point.latitude, point.longitude] as [number, number]);
      if (coordinates.length === 1) map.flyTo(coordinates[0], Math.max(map.getZoom(), 6), { duration: 0.7 });
      else if (coordinates.length > 1) map.fitBounds(coordinates, { padding: [38, 38], maxZoom: maximumZoom });
    };

    const showInstitutionDetail = (id: string) => {
      if (!detail) return;
      if (!id) {
        detail.replaceChildren(...defaultDetailNodes.map((node) => node.cloneNode(true)));
        return;
      }
      const template = document.querySelector(`[data-atlas-detail-template="${CSS.escape(id)}"]`) as HTMLTemplateElement | null;
      if (template) detail.replaceChildren(template.content.cloneNode(true));
    };

    const update = (fitVisible = false) => {
      const pioneer = select?.value || '';
      let visible = 0;
      records.forEach((record) => {
        const matchesPioneer = !pioneer || record.dataset.pioneer === pioneer;
        const matchesKind = kind === 'all' || record.dataset.kind === kind;
        const matchesInstitution = !institution || record.dataset.institution === institution;
        record.hidden = !(matchesPioneer && matchesKind && matchesInstitution);
        if (!record.hidden) visible += 1;
      });
      visibleInstitutionIds = new Set(records.filter((record) => !record.hidden).map((record) => record.dataset.institution || ''));
      markerEntries.forEach(({ point, marker }) => {
        const isVisible = visibleInstitutionIds.has(point.id);
        marker.setOpacity(isVisible ? 1 : 0.17);
        marker.setZIndexOffset(isVisible ? 1000 : 0);
        const markerElement = marker.getElement();
        markerElement?.classList.toggle('is-muted', !isVisible);
        markerElement?.classList.toggle('is-selected', point.id === institution);
      });
      kindButtons.forEach((button) => button.classList.toggle('is-active', button.dataset.atlasKind === kind));
      if (count) count.textContent = `${String(visible).padStart(2, '0')} RECORDS`;
      if (empty) empty.hidden = visible !== 0;
      const url = new URL(window.location.href);
      if (pioneer) url.searchParams.set('pioneer', pioneer); else url.searchParams.delete('pioneer');
      if (kind !== 'all') url.searchParams.set('kind', kind); else url.searchParams.delete('kind');
      if (institution) url.searchParams.set('institution', institution); else url.searchParams.delete('institution');
      window.history.replaceState({}, '', url);
      if (fitVisible) fitMapTo(visibleInstitutionIds, pioneer ? 7 : 4);
    };

    const selectInstitution = (id: string) => {
      institution = institution === id ? '' : id;
      showInstitutionDetail(institution);
      update(false);
      if (institution) fitMapTo(new Set([institution]), 7);
    };
    kindButtons.forEach((button) => button.addEventListener('click', () => { kind = button.dataset.atlasKind || 'all'; institution = ''; showInstitutionDetail(''); update(true); }));
    select?.addEventListener('change', () => { institution = ''; showInstitutionDetail(''); update(true); });
    const params = new URLSearchParams(window.location.search);
    if (select && [...select.options].some((option) => option.value === params.get('pioneer'))) select.value = params.get('pioneer') || '';
    if (kindButtons.some((button) => button.dataset.atlasKind === params.get('kind'))) kind = params.get('kind') || 'all';
    if (points.some((point) => point.id === params.get('institution'))) institution = params.get('institution') || '';
    showInstitutionDetail(institution);
    update(false);
    fitMapTo(institution ? new Set([institution]) : new Set(points.map((point) => point.id)), institution ? 7 : 3);
    if (mapElement && map) new ResizeObserver(() => map.invalidateSize()).observe(mapElement);
  </script>
</BaseLayout>
