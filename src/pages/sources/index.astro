---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceEntry from '../../components/SourceEntry.astro';
import { sources } from '../../data/sources';

const tierGroups = [
  { tier: 'A', label: '원저작과 당사자 기록', note: '핵심 정의와 직접 진술을 확인하는 1차 자료' },
  { tier: 'B', label: '학술·기관 자료', note: '영향 관계와 역사적 맥락을 교차 확인하는 자료' },
  { tier: 'C', label: '백과사전·탐색 자료', note: '후보 사실을 찾고 상위 출처로 이동하기 위한 색인' },
] as const;

const groupedSources = tierGroups.map((group) => ({
  ...group,
  sources: sources
    .filter((source) => source.tier === group.tier)
    .sort((a, b) => a.authors.localeCompare(b.authors, 'en') || a.title.localeCompare(b.title, 'en')),
}));
---
<BaseLayout title="통합 참고문헌">
  <section class="page-hero"><div class="shell"><div class="eyebrow">THE SOURCE ROOM / BIBLIOGRAPHY</div><h1>문장 뒤에<br />남는 것들.</h1><p>원저서, 연구서, 동료평가 논문과 기관 자료를 한 곳에 모았습니다. 등급 배지는 자료의 성격을 뜻하며, 자료의 질을 자동으로 보증하지는 않습니다.</p><div class="hero-meta"><span><b>{sources.length}</b> SOURCES</span><span><b>{sources.filter((s) => s.tier === 'A').length}</b> PRIMARY / EDITED</span><span><b>{sources.filter((s) => s.tier === 'B').length}</b> SCHOLARLY</span></div></div></section>
  <section class="section sources-page">
    <div class="shell source-index">
      <p class="source-index-intro"><span>READING ORDER</span> 등급별로 묶고 저자명순으로 정리했습니다. 각 항목을 누르면 원문이 새 창에서 열립니다.</p>
      <form class="source-search" role="search" data-source-search>
        <label for="source-query">
          <span>SEARCH THE BIBLIOGRAPHY</span>
          <strong>참고문헌 검색</strong>
        </label>
        <div class="source-search-field">
          <span aria-hidden="true">⌕</span>
          <input id="source-query" type="search" placeholder="제목, 저자, 발행처, 연도, DOI 검색" autocomplete="off" spellcheck="false" data-source-query />
          <button type="button" data-source-clear hidden>초기화</button>
        </div>
        <p aria-live="polite"><b data-source-result>{sources.length}</b> / {sources.length} SOURCES</p>
      </form>
      {groupedSources.map((group) => (
        <section class="source-group" aria-labelledby={`source-tier-${group.tier}`} data-source-group>
          <header class="source-group-head">
            <span class={`tier tier-${group.tier}`}>{group.tier}등급</span>
            <div>
              <h2 id={`source-tier-${group.tier}`}>{group.label}</h2>
              <p>{group.note}</p>
            </div>
            <strong data-source-group-count data-source-total={group.sources.length}>{String(group.sources.length).padStart(2, '0')} SOURCES</strong>
          </header>
          <ol class="source-list">
            {group.sources.map((source, index) => <SourceEntry source={source} index={index} />)}
          </ol>
        </section>
      ))}
      <div class="source-empty" data-source-empty hidden>
        <span>NO MATCHING SOURCES</span>
        <p>검색 결과가 없습니다. 제목이나 저자명처럼 더 짧은 검색어를 입력해 보세요.</p>
      </div>
    </div>
  </section>
  <script>
    const searchForm = document.querySelector('[data-source-search]') as HTMLFormElement | null;
    const searchInput = document.querySelector('[data-source-query]') as HTMLInputElement | null;
    const clearButton = document.querySelector('[data-source-clear]') as HTMLButtonElement | null;
    const resultCount = document.querySelector('[data-source-result]') as HTMLElement | null;
    const emptyState = document.querySelector('[data-source-empty]') as HTMLElement | null;
    const sourceGroups = [...document.querySelectorAll('[data-source-group]')] as HTMLElement[];
    const sourceEntries = [...document.querySelectorAll('[data-source-entry]')] as HTMLElement[];

    const normalize = (value: string) => value
      .normalize('NFKD')
      .replace(/\p{M}/gu, '')
      .toLocaleLowerCase()
      .trim();

    sourceEntries.forEach((entry) => {
      entry.dataset.searchIndex = normalize(entry.dataset.searchValue || '');
    });

    const updateSources = () => {
      const query = normalize(searchInput?.value || '');
      const terms = query.split(/\s+/).filter(Boolean);
      let visibleTotal = 0;

      sourceGroups.forEach((group) => {
        group.classList.remove('is-first-visible');
        const entries = [...group.querySelectorAll('[data-source-entry]')] as HTMLElement[];
        let visibleInGroup = 0;

        entries.forEach((entry) => {
          const searchIndex = entry.dataset.searchIndex || '';
          const matches = terms.every((term) => searchIndex.includes(term));
          entry.hidden = !matches;
          if (matches) visibleInGroup += 1;
        });

        group.hidden = visibleInGroup === 0;
        visibleTotal += visibleInGroup;

        const groupCount = group.querySelector('[data-source-group-count]') as HTMLElement | null;
        const groupTotal = Number(groupCount?.dataset.sourceTotal || entries.length);
        if (groupCount) {
          groupCount.textContent = query
            ? `${String(visibleInGroup).padStart(2, '0')} / ${String(groupTotal).padStart(2, '0')} SOURCES`
            : `${String(groupTotal).padStart(2, '0')} SOURCES`;
        }
      });

      sourceGroups.find((group) => !group.hidden)?.classList.add('is-first-visible');
      if (resultCount) resultCount.textContent = String(visibleTotal);
      if (clearButton) clearButton.hidden = !query;
      if (emptyState) emptyState.hidden = visibleTotal !== 0;

      const url = new URL(window.location.href);
      if (query) url.searchParams.set('q', searchInput?.value.trim() || '');
      else url.searchParams.delete('q');
      window.history.replaceState({}, '', url);
    };

    searchForm?.addEventListener('submit', (event) => event.preventDefault());
    searchInput?.addEventListener('input', updateSources);
    searchInput?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && searchInput.value) {
        searchInput.value = '';
        updateSources();
      }
    });
    clearButton?.addEventListener('click', () => {
      if (!searchInput) return;
      searchInput.value = '';
      updateSources();
      searchInput.focus();
    });

    const initialQuery = new URLSearchParams(window.location.search).get('q');
    if (initialQuery && searchInput) {
      searchInput.value = initialQuery;
      updateSources();
    }
  </script>
</BaseLayout>
