---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { archiveIntegrity } from '../data/integrity';
import '../styles/global.css';
void archiveIntegrity;
const {
  title = 'EdTech Pantheon',
  description = '교육공학의 사상을 사람과 관계와 근거로 읽는 공개 아카이브.',
  socialImage = `${import.meta.env.BASE_URL}/brand-mark.png`,
  socialImageAlt = 'EdTech Pantheon 로고',
  socialImageWidth = 256,
  socialImageHeight = 256,
  socialImageType = 'image/png',
} = Astro.props;
const base = `${import.meta.env.BASE_URL}/`;
const pageTitle = `${title} · EdTech Pantheon`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const socialImageUrl = new URL(socialImage, Astro.site ?? Astro.url).href;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={`${base}brand-mark.png`} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#10191b" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content="EdTech Pantheon" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content={socialImageType} />
    <meta property="og:image:width" content={socialImageWidth} />
    <meta property="og:image:height" content={socialImageHeight} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteHeader />
    <main><slot /></main>
    <SiteFooter />
  </body>
</html>
