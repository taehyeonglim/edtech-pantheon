---
import type { Source } from '../data/types';
const { source } = Astro.props as { source: Source };
---
<a class="source-card" href={source.url} target="_blank" rel="noreferrer">
  <div class="source-card-top"><span class={`tier tier-${source.tier}`}>{source.tier}등급</span><span>{source.type}</span></div>
  <h3>{source.title}</h3>
  <p>{source.authors}</p>
  <div class="source-card-meta"><span>{source.year ?? '연도 미상'}</span><span>{source.publisher ?? '온라인 원문'}</span><span aria-hidden="true">↗</span></div>
</a>
