---
import type { Pioneer } from '../data/types';
import { pioneers } from '../data/pioneers';
import { portraitById } from '../data/portraits';
import NationalityBadge from './NationalityBadge.astro';
const { pioneer, featured = false } = Astro.props as { pioneer: Pioneer; featured?: boolean };
const base = `${import.meta.env.BASE_URL}/`;
const portrait = portraitById[pioneer.id];
const displayIndex = pioneers.findIndex((item) => item.id === pioneer.id) + 1;
const portraitStyle = portrait ? [
  portrait.objectPosition && `object-position:${portrait.objectPosition}`,
  portrait.objectScale && `transform:scale(${portrait.objectScale})`,
  portrait.transformOrigin && `transform-origin:${portrait.transformOrigin}`
].filter(Boolean).join(';') : undefined;
---

<a class:list={["pioneer-card", { featured }]} href={`${base}pioneers/${pioneer.slug}/`} data-pioneer-card data-name={`${pioneer.nameKo} ${pioneer.nameEn} ${pioneer.concepts.join(' ')}`} data-era={pioneer.era} data-domains={pioneer.domains.join(',')}>
  <div class:list={["card-portrait", { 'has-photo': portrait }]} style={`--accent:${pioneer.accent}`}>
    {portrait && <img src={`${base}${portrait.src}`} alt={portrait.alt} loading={featured ? 'eager' : 'lazy'} style={portraitStyle} />}
    <span class="portrait-grid"></span>
    {!portrait && <span class="portrait-initials">{pioneer.initials}</span>}
    <span class="portrait-index">{String(displayIndex).padStart(2, '0')}</span>
    <span class="portrait-line"></span>
    <NationalityBadge pioneerId={pioneer.id} className="card-nationality" />
  </div>
  <div class="card-body">
    <div class="card-kicker"><span>{pioneer.era}</span><span>{pioneer.life}</span></div>
    <h3>{pioneer.nameKo}</h3>
    <p class="card-name-en">{pioneer.nameEn}</p>
    <p class="card-role">{pioneer.role}</p>
    <div class="tag-row">{pioneer.domains.map((domain) => <span>{domain}</span>)}</div>
    <div class="card-arrow" aria-hidden="true">↗</div>
  </div>
</a>
