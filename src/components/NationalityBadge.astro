---
import { nationalityById } from '../data/nationalities';
import { getFlagIcons } from '../data/flag-icons';
const { pioneerId, compact = false, className = '' } = Astro.props;
const nationality = nationalityById[pioneerId];
const flagIcons = nationality ? getFlagIcons(nationality.flag) : [];
const base = `${import.meta.env.BASE_URL}/`;
---

{nationality && (
  <span
    class:list={['nationality-badge', { 'is-compact': compact }, className]}
    title={nationality.note}
    aria-label={`국적: ${nationality.label}`}
  >
    {flagIcons.map((flag) => (
      <span class="country-flag">
        <small>{flag.code}</small>
        <img src={`${base}flags/${flag.file}`} alt={flag.alt} width="20" height="14" loading="lazy" />
      </span>
    ))}
    {!compact && <small>{nationality.label}</small>}
  </span>
)}
